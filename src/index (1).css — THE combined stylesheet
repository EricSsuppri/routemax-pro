@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --color-bg: #0a0a0f;
  --color-gold: #e6c57c;
  --color-gold-deep: #b08d3e;
  --color-champagne: #ffecd0;
  --color-surface: #14141c;
  --color-surface-2: #1c1c28;
  --color-border: #2a2a3a;
  --color-accent: #10b981;
  --color-accent-glow: #10b98133;
  --color-text: #f4f4f5;
  --color-text-dim: #a1a1aa;
}

* {
  -webkit-tap-highlight-color: transparent;
}

html {
  background: var(--color-bg);
  -webkit-text-size-adjust: 100%;
  -moz-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background:
    radial-gradient(120% 60% at 50% -10%, rgba(230, 197, 124, 0.05), transparent 60%),
    radial-gradient(100% 50% at 50% 110%, rgba(0, 138, 150, 0.06), transparent 60%),
    var(--color-bg);
  color: var(--color-text);
  overscroll-behavior: none;
  margin: 0;
  padding: 0;
}

/* Prevent iOS auto-zoom on input focus */
@media (max-width: 640px) {
  input, textarea, select {
    font-size: 16px !important;
  }
}

input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

input[type="number"] {
  -moz-appearance: textfield;
}

@keyframes fade-in-up {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px var(--color-accent-glow), 0 0 40px var(--color-accent-glow); }
  50% { box-shadow: 0 0 30px var(--color-accent-glow), 0 0 60px var(--color-accent-glow); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

.animate-fade-in-up {
  animation: fade-in-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.animate-fade-in {
  animation: fade-in 0.4s ease both;
}

.animate-pulse-glow {
  animation: pulse-glow 2.5s ease-in-out infinite;
}

.shimmer-text {
  background: linear-gradient(100deg, #8a6a2f 0%, #e6c57c 20%, #fff3d6 40%, #e6c57c 60%, #8a6a2f 80%, #e6c57c 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 4s linear infinite;
}

.glass {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012) 55%, rgba(230, 197, 124, 0.02));
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 236, 208, 0.09);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.glass-input {
  background: rgba(20, 20, 28, 0.8);
  border: 1px solid var(--color-border);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.glass-input:focus-within {
  border-color: rgba(230, 197, 124, 0.55);
  box-shadow: 0 0 0 3px rgba(230, 197, 124, 0.12);
}

.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* Champagne gold primary button */
.btn-champagne {
  background: linear-gradient(135deg, #f3d894 0%, #e6c57c 35%, #c9a24f 70%, #e6c57c 100%);
  color: #191408;
  box-shadow: 0 8px 28px rgba(230, 197, 124, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  transition: transform 0.15s, box-shadow 0.2s, filter 0.2s;
}
.btn-champagne:hover { filter: brightness(1.06); box-shadow: 0 10px 34px rgba(230, 197, 124, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.45); }
.btn-champagne:active { transform: scale(0.98); }

/* Hairline gold divider */
.gold-hairline {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(230, 197, 124, 0.35), transparent);
}

/* Gold ring for avatar/logo accents */
.gold-ring {
  box-shadow: 0 0 0 1px rgba(230, 197, 124, 0.35), 0 6px 20px rgba(230, 197, 124, 0.18);
}

/* Safe-area padding for notched devices */
.safe-top { padding-top: max(env(safe-area-inset-top), 1rem); }
.safe-bottom { padding-bottom: max(env(safe-area-inset-bottom), 2rem); }

/* ---- Apple-style motion system (v2.41) ---- */

/* Smooth accordion (no JS measuring) */
.acc { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.38s cubic-bezier(0.4, 0, 0.2, 1); }
.acc.acc-open { grid-template-rows: 1fr; }
.acc > div { overflow: hidden; min-height: 0; }

/* Ambient floating orbs */
@keyframes orb { 0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; } 50% { transform: translate(14px, -12px) scale(1.12); opacity: 1; } }
.animate-orb { animation: orb 7s ease-in-out infinite; }

/* Road dashes drifting */
@keyframes dashmove { to { stroke-dashoffset: -32; } }
.animate-dash { animation: dashmove 1.1s linear infinite; }

/* Traveling pulse along the road */
@keyframes drive { 0% { left: 2%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { left: 96%; opacity: 0; } }
.animate-drive { animation: drive 4.5s ease-in-out infinite; }

/* Sheen sweep for primary buttons */
.btn-sheen { position: relative; overflow: hidden; }
.btn-sheen::after { content: ""; position: absolute; top: 0; left: -70%; width: 45%; height: 100%; background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.5), transparent); transform: skewX(-20deg); animation: sheen 3.4s ease-in-out infinite; pointer-events: none; }
@keyframes sheen { 0%, 60% { left: -70%; } 100% { left: 150%; } }

/* Gentle float for badges */
@keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
.animate-floaty { animation: floaty 5s ease-in-out infinite; }

/* ---- Living-app micro-animations (v2.44) ---- */
@keyframes twinkle { 0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; } 50% { transform: scale(1.18) rotate(12deg); opacity: 0.85; } }
.animate-twinkle { animation: twinkle 2.6s ease-in-out infinite; }

@keyframes tabpop { 0% { transform: scale(0.6); } 55% { transform: scale(1.28); } 100% { transform: scale(1); } }
.animate-tabpop { animation: tabpop 0.38s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes pop { 0% { transform: scale(0.4); opacity: 0; } 60% { transform: scale(1.15); opacity: 1; } 100% { transform: scale(1); } }
.animate-pop { animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes softring { 0% { transform: scale(0.92); opacity: 0.55; } 100% { transform: scale(1.25); opacity: 0; } }
.animate-softring { animation: softring 2.2s ease-out infinite; }

@keyframes glowpulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
.animate-glowpulse { animation: glowpulse 3.2s ease-in-out infinite; }

/* Bottom-sheet entrance */
@keyframes sheetup { from { transform: translateY(64px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.animate-sheetup { animation: sheetup 0.32s cubic-bezier(0.32, 0.72, 0, 1); }
